{
  "name": "antigravity-rtl",
  "displayName": "Antigravity RTL",
  "description": "Smart RTL, Vazirmatn typography for Chat/AI/Composer, and workspace ergonomics for Antigravity IDE",
  "version": "1.0.3",
  "publisher": "omid-io",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/omid-io/antigravity-ui.git"
  },
  "bugs": {
    "url": "https://github.com/omid-io/antigravity-ui/issues"
  },
  "homepage": "https://github.com/omid-io/antigravity-ui#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "antigravity",
    "antigravity-ui",
    "rtl",
    "persian",
    "arabic",
    "vazirmatn",
    "bidi"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "markdown.previewStyles": [
      "./resources/markdown-preview-rtl.css"
    ],
    "commands": [
      {
        "command": "antigravity-ui.toggleRtl",
        "title": "Antigravity UI: Toggle RTL (فعال / غیرفعال)",
        "category": "Antigravity UI"
      },
      {
        "command": "antigravity-ui.enable",
        "title": "Antigravity UI: Enable RTL & Typography",
        "category": "Antigravity UI"
      },
      {
        "command": "antigravity-ui.disable",
        "title": "Antigravity UI: Disable RTL",
        "category": "Antigravity UI"
      },
      {
        "command": "antigravity-ui.setupTypography",
        "title": "Antigravity UI: Configure Editor Typography",
        "category": "Antigravity UI"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity-ui.toggleRtl",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ]
  },
  "scripts": {
    "vscode:uninstall": "node uninstall.js"
  }
}
